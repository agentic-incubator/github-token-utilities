{
  "name": "github-token-utilities",
  "version": "3.2.0",
  "description": "CLI tools and cross-agent skills for managing GitHub personal access tokens: generate, audit, and rotate",
  "type": "module",
  "bin": {
    "gen-gh-token": "./generator.mjs",
    "audit-gh-tokens": "./audit.mjs",
    "rotate-gh-token": "./rotate.mjs",
    "store-gh-token": "./store.mjs",
    "revoke-gh-token": "./revoke.mjs"
  },
  "scripts": {
    "setup": "node setup.mjs",
    "generate": "node generator.mjs",
    "audit": "node audit.mjs",
    "rotate": "node rotate.mjs",
    "test": "node --test --test-timeout=120000 tests/*.test.mjs",
    "build:skills": "node scripts/build-skills.mjs",
    "check:skills": "node scripts/build-skills.mjs --check",
    "install:skills": "node scripts/install-skills.mjs",
    "validate:skills": "node scripts/build-skills.mjs --check && for d in skills/dist/*/github-token-utilities; do uvx --from skills-ref agentskills validate \"$d\" || exit 1; done",
    "store": "node store.mjs",
    "package": "node scripts/package-release.mjs",
    "revoke": "node revoke.mjs",
    "check:links": "node scripts/check-links.mjs"
  },
  "keywords": [
    "github",
    "token",
    "pats",
    "cli",
    "personal-access-token",
    "automation",
    "interactive",
    "security",
    "audit",
    "rotation",
    "agent-skills",
    "claude-code",
    "codex",
    "opencode",
    "gemini-cli",
    "hermes-agent",
    "grok",
    "revoke"
  ],
  "author": "agentic-incubator",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agentic-incubator/github-token-utilities.git"
  },
  "homepage": "https://github.com/agentic-incubator/github-token-utilities",
  "bugs": {
    "url": "https://github.com/agentic-incubator/github-token-utilities/issues"
  },
  "files": [
    "generator.mjs",
    "audit.mjs",
    "rotate.mjs",
    "setup.mjs",
    "store.mjs",
    "revoke.mjs",
    "gh-token-lib.mjs",
    "skills/",
    "scripts/",
    "README.md",
    "LICENSE",
    "docs/"
  ]
}
